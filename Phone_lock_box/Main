
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>
#include <Servo.h>

// ============================================================
//  HARDWARE CONFIGURATION
// ============================================================

#define SCREEN_W   128
#define SCREEN_H    64
#define OLED_RESET  -1
#define OLED_ADDR   0x3C

Adafruit_SH1106G oled(SCREEN_W, SCREEN_H, &Wire, OLED_RESET);
Servo srv;

// Following this to wiring 
const uint8_t PIN_B1     = 2;
const uint8_t PIN_B2     = 3;
const uint8_t PIN_B3     = 8;
const uint8_t PIN_SERVO  = 11;
const uint8_t PIN_TRIG   = 12;
const uint8_t PIN_ECHO   = 7;
const uint8_t PIN_BUZZER = 5;   

// ============================================================
//  EMERGENCY PASSWORD
// ============================================================

// Password: button 1,1,2,3
const uint8_t EMERG_SEQ[4] = { 1, 1, 2, 3 };
#define EMERG_LEN 4

// ============================================================
//  TIMING CONSTANTS
// ============================================================

const uint32_t STUDY_MS      = 1UL * 60UL * 1000UL;  // Changing time here 
const uint32_t OVERRIDE_HOLD = 3000;
const uint32_t SKIP_HOLD     = 4000;
const uint32_t DEBOUNCE      =   50;
const uint32_t ANIM_FRAME    =  400;
const uint32_t REMOVAL_BUF   = 2000;
const uint32_t ANGRY_SHOW    = 3000;
const uint32_t DIST_POLL     =  100;
const uint32_t BLINK_PERIOD  = 3000;
const uint32_t BLINK_OPEN_MS =  150;
const uint32_t EMERG_TIMEOUT = 5000;
const int      COUNTDOWN_S   =    5;

// ============================================================
//  DISTANCE THRESHOLDS 
// ============================================================

const int DIST_REMOVED = 14; //Remove from the box  
const int DIST_PRESENT = 8; // The phone is in the box
const int DIST_IDLE    = 16; // no phone in the box 

// ============================================================
//  FACE LAYOUT
// ============================================================

#define LX  13
#define LY  22
#define RX  37
#define RY  22
#define MX  25
#define MY  44
#define ER   8

#define CLR_WHITE  SH110X_WHITE
#define CLR_BLACK  SH110X_BLACK

// ============================================================
//  STATE VARIABLES
// ============================================================


bool     locked       = false;
bool     phoneOut     = true;
uint32_t lockStart    = 0;
int32_t  lastDist     = 999;
uint32_t lastDistPoll = 0;

int  codePwd[3], codeIn[3], codeIdx = 0;
bool codeActive = false;

uint32_t bTime[3] = {};
bool     bDown[3] = {};
bool     bEdge[3] = {};

uint32_t overrideStart = 0; bool overrideArmed = false;
uint32_t skipStart     = 0; bool skipArmed     = false;

uint32_t angryStart   = 0; bool angryOn   = false;
uint32_t angryChStart = 0; bool angryChOn = false;

uint32_t animTick  = 0; uint8_t animFr = 0;
uint32_t blinkTick = 0;

uint32_t lockSeqStart   = 0; bool lockingFlow  = false;
uint32_t removalStart   = 0; bool removalCheck = false;
uint32_t unlockCntStart = 0; bool unlockCntOn  = false;
bool     waitSleep      = false;
bool     phoneTaken     = false;
int32_t  minDistCh      = 20;

uint8_t  emergIn[EMERG_LEN] = {};
uint8_t  emergIdx  = 0;
uint32_t emergLast = 0;

// ── Countdown beep tracking ──────────────────────────────────
int lastCountdownBeepRem = -1;   // Tracks which second we last beeped on

// ============================================================
//  BUZZER HELPERS, THE SOUND FOR EACH ACTION 
// ============================================================

// Single short beep, used for each countdown tick
void buzzTick() {
  tone(PIN_BUZZER, 880, 80);
}

// Final countdown beep
void buzzCountdownFinal() {
  tone(PIN_BUZZER, 1046, 200);
}

// Wrong code/cheat attempt
void buzzWrong() {
  tone(PIN_BUZZER, 400, 80);
  delay(100);
  tone(PIN_BUZZER, 280, 150);
}

// Correct digit entered 
void buzzCorrectDigit() {
  tone(PIN_BUZZER, 1200, 60);
}

// Unlock success 
void buzzUnlock() {
  tone(PIN_BUZZER, 784, 100); delay(120);
  tone(PIN_BUZZER, 988, 100); delay(120);
  tone(PIN_BUZZER, 1175, 180);
}


// ============================================================
//  OLED DRAWING PRIMITIVES
// ============================================================
void sep() { oled.drawLine(51, 0, 51, 63, CLR_WHITE); }

void rLabel(const __FlashStringHelper* l1,
            const __FlashStringHelper* l2 = nullptr) {
  oled.setTextColor(CLR_WHITE); oled.setTextSize(1);
  if (!l2) { oled.setCursor(54, 28); oled.print(l1); }
  else     { oled.setCursor(54, 18); oled.print(l1);
             oled.setCursor(54, 34); oled.print(l2); }
}

void rCountdown(const __FlashStringHelper* verb, int rem) {
  oled.setTextColor(CLR_WHITE);
  oled.setTextSize(1); oled.setCursor(54, 8); oled.print(verb);
  oled.setTextSize(3); oled.setCursor(70, 22); oled.print(rem);
  int filled = COUNTDOWN_S - rem;
  for (int i = 0; i < filled && i < COUNTDOWN_S; i++)
    oled.fillRect(54 + i * 13, 52, 10, 8, CLR_WHITE);
}

bool getBlink(uint32_t t) {
  if (t - blinkTick < BLINK_OPEN_MS) return true;
  if (t - blinkTick >= BLINK_PERIOD) blinkTick = t;
  return false;
}

// ── Eye primitives ──────────────────────────────────────────
void eyeOpen(int x, int y, int r = ER) {
  oled.fillCircle(x, y, r, CLR_WHITE);
  oled.fillCircle(x, y, r / 2 + 1, CLR_BLACK);
  oled.fillCircle(x - 2, y - 2, max(1, r / 4), CLR_WHITE);
}
void eyeClose(int x, int y, int r = ER) {
  oled.drawLine(x - r,     y,     x + r,     y,     CLR_WHITE);
  oled.drawLine(x - r + 1, y + 1, x + r - 1, y + 1, CLR_WHITE);
}
void eyeHeart(int x, int y) {
  oled.fillCircle(x - 3, y - 1, 5, CLR_WHITE);
  oled.fillCircle(x + 3, y - 1, 5, CLR_WHITE);
  oled.fillTriangle(x - 7, y + 3, x + 7, y + 3, x, y + 9, CLR_WHITE);
}
void eyeX(int x, int y, int r = ER) {
  oled.drawLine(x - r, y - r, x + r, y + r, CLR_WHITE);
  oled.drawLine(x + r, y - r, x - r, y + r, CLR_WHITE);
}
void eyeAngry(int x, int y, bool left, int r = ER) {
  oled.fillCircle(x, y, r, CLR_WHITE);
  if (left) oled.fillTriangle(x-r, y-r, x+r, y-r, x-r, y-1, CLR_BLACK);
  else      oled.fillTriangle(x-r, y-r, x+r, y-r, x+r, y-1, CLR_BLACK);
  oled.fillCircle(x, y, r / 2 + 1, CLR_BLACK);
  if (left) oled.drawLine(x-r, y-r-3, x+r, y-r+1, CLR_WHITE);
  else      oled.drawLine(x-r, y-r+1, x+r, y-r-3, CLR_WHITE);
}
void eyeSquint(int x, int y, int r = ER) {
  oled.fillCircle(x, y, r, CLR_WHITE);
  oled.fillRect(x - r, y - r, r * 2 + 1, r - 1, CLR_BLACK);
  oled.fillCircle(x, y, r / 2, CLR_BLACK);
}

// ── Mouth primitives ────────────────────────────────────────
void mSmile() {
  oled.drawCircle(MX, MY - 5, 9, CLR_WHITE);
  oled.fillRect(MX - 10, MY - 14, 20, 9, CLR_BLACK);
}
void mFrown() {
  oled.drawCircle(MX, MY + 6, 9, CLR_WHITE);
  oled.fillRect(MX - 10, MY + 6, 20, 9, CLR_BLACK);
}
void mFlat() {
  oled.drawLine(MX - 7, MY, MX + 7, MY, CLR_WHITE);
  oled.drawLine(MX - 7, MY + 1, MX + 7, MY + 1, CLR_WHITE);
}
void mOval() {
  oled.drawCircle(MX, MY, 5, CLR_WHITE);
  oled.drawCircle(MX, MY, 4, CLR_WHITE);
}
void mTiny() { oled.drawLine(MX - 2, MY, MX + 2, MY, CLR_WHITE); }
void mCute() {
  for (int x = -5; x <= 5; x++) {
    int y = (x * x) / 6;
    oled.drawPixel(MX + x, MY + y,     CLR_WHITE);
    oled.drawPixel(MX + x, MY + y + 1, CLR_WHITE);
  }
}
void blush() {
  oled.fillRect(LX - 8, LY + ER, 5, 2, CLR_WHITE);
  oled.fillRect(RX + 3, RY + ER, 5, 2, CLR_WHITE);
}


// ============================================================
//  FACE FUNCTIONS
// ============================================================
void fSleep(uint8_t fr, bool blink) {
  oled.clearDisplay(); sep();
  if (blink) {
    oled.drawLine(LX-ER, LY+1, LX+ER, LY+1, CLR_WHITE);
    oled.drawLine(RX-ER, RY+1, RX+ER, RY+1, CLR_WHITE);
  } else {
    for (int d = 0; d < 3; d++) {
      oled.drawLine(LX-ER+d, LY+d, LX+ER-d, LY+d, CLR_WHITE);
      oled.drawLine(RX-ER+d, RY+d, RX+ER-d, RY+d, CLR_WHITE);
    }
  }
  mTiny();
  oled.setTextColor(CLR_WHITE);
  if (fr >= 1) { oled.setTextSize(1); oled.setCursor(38,13); oled.print(F("z")); }
  if (fr >= 2) { oled.setTextSize(1); oled.setCursor(42, 7); oled.print(F("z")); }
  if (fr >= 3) { oled.setTextSize(2); oled.setCursor(44, 0); oled.print(F("Z")); }
  rLabel(F("SLEEPING"), F("ZZZ..."));
  oled.display();
}

void fCute(bool blink, const __FlashStringHelper* t1,
           const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  int r = ER - 2;
  if (blink) { eyeClose(LX,LY,r); eyeClose(RX,RY,r); }
  else {
    oled.fillCircle(LX,LY,r,CLR_WHITE); oled.fillCircle(LX,LY,r/2,CLR_BLACK); oled.fillCircle(LX-1,LY-1,1,CLR_WHITE);
    oled.fillCircle(RX,RY,r,CLR_WHITE); oled.fillCircle(RX,RY,r/2,CLR_BLACK); oled.fillCircle(RX-1,RY-1,1,CLR_WHITE);
  }
  blush(); mCute(); rLabel(t1, t2); oled.display();
}

void fFocus(bool blink, uint32_t elapsed) {
  oled.clearDisplay(); sep();
  if (blink) { eyeClose(LX,LY); eyeClose(RX,RY); }
  else {
    eyeOpen(LX,LY); eyeOpen(RX,RY);
    oled.drawLine(LX-ER, LY-ER-1, LX+ER, LY-ER+1, CLR_WHITE);
    oled.drawLine(RX-ER, RY-ER+1, RX+ER, RY-ER-1, CLR_WHITE);
  }
  mFlat();
  uint32_t rem  = STUDY_MS - elapsed;
  uint32_t mins = (rem / 1000) / 60;
  uint32_t secs = (rem / 1000) % 60;
  oled.setTextColor(CLR_WHITE);
  oled.setTextSize(1); oled.setCursor(54, 8);  oled.print(F("STUDYING"));
  oled.setTextSize(2); oled.setCursor(54, 22);
  if (mins < 10) oled.print('0'); oled.print(mins);
  oled.print(':');
  if (secs < 10) oled.print('0'); oled.print(secs);
  const int bx=54,by=50,bw=73,bh=8;
  oled.drawRect(bx,by,bw,bh,CLR_WHITE);
  int fill = (int)((float)elapsed / STUDY_MS * (bw - 2));
  if (fill > 0) oled.fillRect(bx+1,by+1,fill,bh-2,CLR_WHITE);
  oled.display();
}

void fAngry(const __FlashStringHelper* t1,
            const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  eyeAngry(LX,LY,true); eyeAngry(RX,RY,false);
  mFrown(); rLabel(t1,t2); oled.display();
}

void fSuspicious(const __FlashStringHelper* t1,
                 const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  oled.drawLine(LX-ER, LY-ER-3, LX+ER, LY-ER+0, CLR_WHITE);
  oled.drawLine(RX-ER, RY-ER+0, RX+ER, RY-ER-3, CLR_WHITE);
  eyeSquint(LX,LY); eyeSquint(RX,RY);
  mFlat(); rLabel(t1,t2); oled.display();
}

void fSurprised(bool blink, const __FlashStringHelper* t1,
                const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  int r = ER + 2;
  if (blink) { eyeClose(LX,LY,r); eyeClose(RX,RY,r); }
  else {
    eyeOpen(LX,LY,r); eyeOpen(RX,RY,r);
    oled.drawLine(LX-r, LY-r-2, LX+r, LY-r-2, CLR_WHITE);
    oled.drawLine(RX-r, RY-r-2, RX+r, RY-r-2, CLR_WHITE);
  }
  mOval(); rLabel(t1,t2); oled.display();
}

void fReward(bool blink, const __FlashStringHelper* t1,
             const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  if (blink) { eyeClose(LX,LY); eyeClose(RX,RY); }
  else       { eyeHeart(LX,LY); eyeHeart(RX,RY); }
  mSmile(); rLabel(t1,t2); oled.display();
}

void fShy(const __FlashStringHelper* t1,
          const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  oled.drawLine(LX-ER,LY,LX,LY-4,CLR_WHITE); oled.drawLine(LX,LY-4,LX+ER,LY,CLR_WHITE);
  oled.drawLine(LX-ER,LY,LX,LY+4,CLR_WHITE); oled.drawLine(LX,LY+4,LX+ER,LY,CLR_WHITE);
  oled.drawLine(RX-ER,RY,RX,RY-4,CLR_WHITE); oled.drawLine(RX,RY-4,RX+ER,RY,CLR_WHITE);
  oled.drawLine(RX-ER,RY,RX,RY+4,CLR_WHITE); oled.drawLine(RX,RY+4,RX+ER,RY,CLR_WHITE);
  blush(); mSmile(); rLabel(t1,t2); oled.display();
}

void fDizzy(const __FlashStringHelper* t1,
            const __FlashStringHelper* t2 = nullptr) {
  oled.clearDisplay(); sep();
  eyeX(LX,LY); eyeX(RX,RY);
  for (int x = -8; x <= 8; x++)
    oled.drawPixel(MX+x, MY+((abs(x)%4<2)?0:3), CLR_WHITE);
  rLabel(t1,t2); oled.display();
}

void fLockingCountdown(bool blink, int rem) {
  oled.clearDisplay(); sep();
  int r = ER + 2;
  if (blink) { eyeClose(LX,LY,r); eyeClose(RX,RY,r); }
  else {
    eyeOpen(LX,LY,r); eyeOpen(RX,RY,r);
    oled.drawLine(LX-r, LY-r-2, LX+r, LY-r-2, CLR_WHITE);
    oled.drawLine(RX-r, RY-r-2, RX+r, RY-r-2, CLR_WHITE);
  }
  mOval(); rCountdown(F("LOCKING IN"), rem); oled.display();
}

void fCuteCountdown(bool blink, const __FlashStringHelper* verb, int rem) {
  oled.clearDisplay(); sep();
  int r = ER - 2;
  if (blink) { eyeClose(LX,LY,r); eyeClose(RX,RY,r); }
  else {
    oled.fillCircle(LX,LY,r,CLR_WHITE); oled.fillCircle(LX,LY,r/2,CLR_BLACK); oled.fillCircle(LX-1,LY-1,1,CLR_WHITE);
    oled.fillCircle(RX,RY,r,CLR_WHITE); oled.fillCircle(RX,RY,r/2,CLR_BLACK); oled.fillCircle(RX-1,RY-1,1,CLR_WHITE);
  }
  blush(); mCute(); rCountdown(verb, rem); oled.display();
}

void fEmergency() {
  oled.clearDisplay(); sep();
  eyeHeart(LX,LY); eyeHeart(RX,RY); mSmile();
  oled.setTextColor(CLR_WHITE); oled.setTextSize(1);
  oled.setCursor(54, 8);  oled.print(F("EMERGENCY"));
  oled.setCursor(54, 24); oled.print(F("UNLOCK!"));
  oled.setCursor(54, 40); oled.print(F("OPENING..."));
  oled.display();
}

void fChallenge(int pwd[3], int inputLen, int in[3]) {
  oled.clearDisplay(); sep();
  eyeOpen(LX,LY); eyeOpen(RX,RY); mSmile();
  oled.setTextColor(CLR_WHITE); oled.setTextSize(1);
  oled.setCursor(54,  6); oled.print(F("ENTER CODE:"));
  oled.setCursor(54, 18);
  oled.print((char)('0'+pwd[0])); oled.print('-');
  oled.print((char)('0'+pwd[1])); oled.print('-');
  oled.print((char)('0'+pwd[2]));
  oled.setCursor(54, 34); oled.print(F("YOUR INPUT:"));
  oled.setCursor(54, 46);
  for (int i = 0; i < 3; i++) {
    if (i < inputLen) { oled.print((char)('0'+in[i])); oled.print(' '); }
    else              oled.print(F("_ "));
  }
  oled.setCursor(54, 56); oled.print(F("1  2  3"));
  oled.display();
}


// ============================================================
//  RANDOM CHEAT EXPRESSION
// ============================================================


void showCheatFace() {
  switch (random(5)) {
    case 0: fAngry     (F("NOT YET!!"), F("FOCUS!"));      break;
    case 1: fSuspicious(F("HEY!"),      F("STOP THAT!"));  break;
    case 2: fAngry     (F("GO BACK"),   F("TO WORK!"));    break;
    case 3: fShy       (F("SHY..."),    F("NO CHEAT!"));   break;
    case 4: fDizzy     (F("DIZZY..."),  F("STAY FOCUS"));  break;
  }
}


// ============================================================
//  SERVO CONTROL
// ============================================================

void lockBox() {
  srv.attach(PIN_SERVO); srv.write(180); delay(1000); srv.detach();
  locked = true; lockStart = millis();
  codeActive = false; angryOn = false;
  lastCountdownBeepRem = -1;  // reset beep tracker for next locking
}

void unlockBox() {
  buzzUnlock();                         // ← success melody
  srv.attach(PIN_SERVO); srv.write(0); delay(1000); srv.detach();
  locked       = false;
  phoneOut     = false;
  codeActive   = angryOn = angryChOn = lockingFlow = false;
  removalCheck = unlockCntOn = waitSleep = false;
  codeIdx      = 0;
  animFr       = 0;
  animTick     = blinkTick = millis();
  oled.clearDisplay(); oled.display();
}


// ============================================================
//  DISTANCE MEASUREMENT
// ============================================================

int32_t getDistance() {
  digitalWrite(PIN_TRIG, LOW);  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH); delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);
  long dur = pulseIn(PIN_ECHO, HIGH, 25000);
  if (dur == 0) return 999;
  return (int32_t)((dur / 2) / 29.1);
}


// ============================================================
//  BUTTON HANDLING
// ============================================================

void updateButtons() {
  uint32_t t = millis();
  const uint8_t pins[3] = { PIN_B1, PIN_B2, PIN_B3 };
  for (int i = 0; i < 3; i++) {
    bool s = (digitalRead(pins[i]) == LOW);
    if (s && !bDown[i] && (t - bTime[i] > DEBOUNCE)) {
      bDown[i] = true; bEdge[i] = true; bTime[i] = t;
    } else {
      bEdge[i] = false;
      if (!s) bDown[i] = false;
    }
  }
}


// ============================================================
//  EMERGENCY PASSWORD
// ============================================================

void checkEmergency(uint8_t btn) {
  uint32_t t = millis();
  if (emergIdx > 0 && (t - emergLast) > EMERG_TIMEOUT) emergIdx = 0;
  emergIn[emergIdx++] = btn;
  emergLast = t;
  if (emergIdx == EMERG_LEN) {
    bool ok = true;
    for (int i = 0; i < EMERG_LEN; i++)
      if (emergIn[i] != EMERG_SEQ[i]) { ok = false; break; }
    emergIdx = 0;
    if (ok) { fEmergency(); unlockBox(); }
  }
}


// ============================================================
//  FORWARD DECLARATIONS
// ============================================================

void showSleeping(uint32_t t, bool blink);
void showRemovalPrompt(int32_t dist, uint32_t t, bool blink);
void runLocking(uint32_t t, bool blink);
void handleChallenge(uint32_t t, int32_t dist, bool blink);


// ============================================================
//  SETUP
// ============================================================

void setup() {
  delay(500);
  randomSeed(analogRead(A1));
  pinMode(PIN_TRIG,   OUTPUT);
  pinMode(PIN_ECHO,   INPUT);
  pinMode(PIN_B1,     INPUT_PULLUP);
  pinMode(PIN_B2,     INPUT_PULLUP);
  pinMode(PIN_B3,     INPUT_PULLUP);
  pinMode(PIN_BUZZER, OUTPUT);         // ← buzzer pin

  if (!oled.begin(OLED_ADDR, false)) {
    pinMode(LED_BUILTIN, OUTPUT);
    while (true) { digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); delay(300); }
  }

  oled.setTextWrap(false);
  oled.clearDisplay();
  oled.display();

  unlockBox();
  phoneOut = true;
}


// ============================================================
//  MAIN LOOP
// ============================================================

void loop() {
  uint32_t t = millis();

  updateButtons();

  for (int i = 0; i < 3; i++)
    if (bEdge[i]) checkEmergency((uint8_t)(i + 1));

  if (t - lastDistPoll >= DIST_POLL) {
    int32_t d = getDistance();
    if (d < 200) lastDist = d;
    lastDistPoll = t;
  }
  int32_t dist  = lastDist;
  bool    blink = getBlink(t);

  // Master override: hold B1+B3 for 3s -> force unlock
  if (bDown[0] && bDown[2]) {
    if (!overrideArmed) { overrideStart = t; overrideArmed = true; }
    else if (t - overrideStart >= OVERRIDE_HOLD) {
      unlockBox(); overrideArmed = false;
      fSurprised(false, F("OVERRIDE!"), F("UNLOCKED"));
      delay(1500); return;
    }
  } else overrideArmed = false;

  // Skip timer: hold B2 for 4s while locked -> jump to challenge
  if (locked) {
    if (bDown[1]) {
      if (!skipArmed) { skipStart = t; skipArmed = true; }
      else if (t - skipStart >= SKIP_HOLD) {
        lockStart = t - STUDY_MS; codeActive = false; skipArmed = false;
        oled.clearDisplay(); oled.display();
      }
    } else skipArmed = false;
  }

  // Phone removal prompt (box just unlocked – phone still inside)
  if (!phoneOut) { showRemovalPrompt(dist, t, blink); return; }

  // Idle / sleeping — but NOT if locking is already in progress
  if (!locked && dist > DIST_IDLE && !lockingFlow) {
    if (overrideArmed) {
      static uint32_t lastOverrideDraw = 0;
      if (t - lastOverrideDraw >= 150) {
        lastOverrideDraw = t;
        uint32_t held  = t - overrideStart;
        int secsLeft   = (int)((OVERRIDE_HOLD - held) / 1000) + 1;
        if (secsLeft < 1) secsLeft = 1;
        oled.clearDisplay(); sep();
        eyeOpen(LX,LY); eyeOpen(RX,RY); mFlat();
        oled.setTextColor(CLR_WHITE);
        oled.setTextSize(1); oled.setCursor(54, 8);  oled.print(F("HOLD B1+B3"));
        oled.setTextSize(1); oled.setCursor(54, 22); oled.print(F("OVERRIDE IN"));
        oled.setTextSize(3); oled.setCursor(74, 34); oled.print(secsLeft);
        oled.display();
      }
    } else {
      showSleeping(t, blink);
    }
    return;
  }

  // Locking sequence: phone placed in box
  if (!locked && dist <= DIST_PRESENT && phoneOut && !waitSleep) {
    bool canLock = false;
    if (!phoneTaken) {
      canLock = true;
    } else {
      static uint32_t backMs = 0;
      if (dist <= DIST_PRESENT) {
        if (backMs == 0) backMs = t;
        if (t - backMs >= 10000) canLock = true;
      } else backMs = 0;
    }
    if (canLock) {
      if (!lockingFlow) { lockSeqStart = t; lockingFlow = true; lastCountdownBeepRem = COUNTDOWN_S + 1; }
      runLocking(t, blink);
    }
    return;
  }

  // Locked state
  if (locked) {
    uint32_t elapsed = t - lockStart;
    if (elapsed < STUDY_MS) {
      if ((bEdge[0] || bEdge[2]) && !skipArmed && !codeActive && !angryOn) {
        buzzWrong();                    // ← cheat attempt buzz
        showCheatFace(); angryOn = true; angryStart = t;
      }
      if (angryOn) {
        if (t - angryStart >= ANGRY_SHOW) { angryOn = false; oled.clearDisplay(); oled.display(); }
        return;
      }
      fFocus(blink, elapsed);
    } else {
      handleChallenge(t, dist, blink);
    }
    return;
  }

  // Fallback: dead zone → show sleeping
  showSleeping(t, blink);
}


// ============================================================
//  STATE SCREEN DEFINITIONS
// ============================================================

void showSleeping(uint32_t t, bool blink) {
  if (t - animTick >= ANIM_FRAME) { animFr = (animFr + 1) % 4; animTick = t; }
  // TEMP: show distance instead of sleeping face
  oled.clearDisplay();
  oled.setTextColor(CLR_WHITE);
  oled.setTextSize(1); oled.setCursor(0, 0);  oled.print(F("DIST:"));
  oled.setTextSize(3); oled.setCursor(0, 20); oled.print(lastDist);
  oled.setTextSize(1); oled.setCursor(0, 54); oled.print(F("PRESENT=15 IDLE=15"));
  oled.display();
}

void showRemovalPrompt(int32_t dist, uint32_t t, bool blink) {
  if (dist <= DIST_REMOVED) {
    fCute((t / 300) % 2 == 1, F("TAKE PHONE!"), F("OPEN LID :)"));
    removalCheck = false;
    unlockCntOn  = false;
    return;
  }
  if (!removalCheck) { removalStart = t; removalCheck = true; }
  if (t - removalStart >= REMOVAL_BUF) {
    if (!unlockCntOn) { unlockCntStart = t; unlockCntOn = true; }
    int rem = (int)(COUNTDOWN_S - (t - unlockCntStart) / 1000);
    if (rem > 0) {
      fCuteCountdown(blink, F("TAKE PHONE"), rem);
    } else {
      phoneOut = true; removalCheck = false; unlockCntOn = false;
      codeActive = false; codeIdx = 0;
      oled.clearDisplay(); oled.display();
    }
  } else {
    fCute(blink, F("TAKE PHONE!"), F("OPEN LID :)"));
  }
}

void runLocking(uint32_t t, bool blink) {
  int rem = (int)(COUNTDOWN_S - (t - lockSeqStart) / 1000);
  if (rem > 0) {
    // Beep once per second as the countdown ticks down
    if (rem != lastCountdownBeepRem) {
      lastCountdownBeepRem = rem;
      if (rem == 1) buzzCountdownFinal();  // ← low thump on last second
      else          buzzTick();            // ← short tick on each other second
    }
    fLockingCountdown(blink, rem);
  } else {
    lockBox(); lockingFlow = false; phoneTaken = false;
  }
}

void handleChallenge(uint32_t t, int32_t dist, bool blink) {
  static uint32_t rewardStart = 0;

  if (!codeActive) {
    fReward(blink, F("TIME UP!"), F("GOOD JOB!"));
    if (rewardStart == 0) { rewardStart = t; minDistCh = dist; }
    if (t - rewardStart < 3000) return;
    for (int i = 0; i < 3; i++) codePwd[i] = random(1, 4);
    codeActive = true; codeIdx = 0;
    rewardStart = 0; waitSleep = false; angryChOn = false;
    oled.clearDisplay(); oled.display();
  }

  if (dist < minDistCh) minDistCh = dist;

  if (!waitSleep && dist > minDistCh + 2 && dist > DIST_REMOVED) {
    waitSleep = true; phoneTaken = true;
    unlockCntStart = t; codeActive = false; angryChOn = false;
    oled.clearDisplay();
  }
  if (waitSleep) {
    int rem = (int)(COUNTDOWN_S - (t - unlockCntStart) / 1000);
    if (rem > 0) {
      fCuteCountdown(blink, F("GOING SLEEP"), rem);
    } else {
      waitSleep = false; phoneOut = true;
      codeActive = false; codeIdx = 0; phoneTaken = true;
      oled.clearDisplay(); oled.display();
    }
    return;
  }

  if (angryChOn) {
    if (t - angryChStart >= ANGRY_SHOW) { angryChOn = false; oled.clearDisplay(); oled.display(); }
    return;
  }

  fChallenge(codePwd, codeIdx, codeIn);

  int b = 0;
  if (bEdge[0]) b = 1;
  else if (bEdge[1]) b = 2;
  else if (bEdge[2]) b = 3;

  if (b > 0 && codeIdx < 3) {
    if (b != codePwd[codeIdx]) {
      buzzWrong();                      // ← wrong digit buzz
      showCheatFace(); angryChOn = true; angryChStart = t; codeIdx = 0; return;
    }
    buzzCorrectDigit();                 // ← correct digit blip
    codeIn[codeIdx++] = b;
    if (codeIdx == 3) { phoneTaken = true; unlockBox(); }
  }
}
